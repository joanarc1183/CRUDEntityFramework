@using HospitalPatientManager.ViewModels
@model DoctorPatientsViewModel
@{
    ViewData["Title"] = "Doctor Patients";
}

<div class="shell">
    <aside class="sidebar" id="sidebar">
        <div class="brand"><strong>MediCare</strong></div>
        <nav class="nav">
            <a href="/Doctor/Dashboard?userId=@Model.Doctor.Id">Dashboard</a>
            <a class="active" href="/Doctor/Patients?userId=@Model.Doctor.Id">Patients</a>
            <a href="/Doctor/Records?userId=@Model.Doctor.Id">All Records</a>
        </nav>
        <div class="sidebar-user">
            <div class="avatar">@Model.Initials</div>
            <div><div style="font-size:14px;font-weight:600;">@Model.Doctor.FullName</div><div style="font-size:12px;color:#8eabb5;">Doctor</div></div>
            <a href="/Account/Logout" class="btn btn-primary" style="margin-left:auto;padding:6px 10px;">Out</a>
        </div>
    </aside>

    <div class="content">
        <header class="mobile-top">
            <button class="menu-btn" data-open-menu>☰</button>
            <strong>MediCare</strong>
            <div class="avatar" style="width:30px;height:30px;font-size:12px;">@Model.Initials</div>
        </header>
        <div class="page">
            <h1 style="font-size:28px;">Patients</h1>
            <p class="muted" style="margin-top:6px;">View detailed information about your assigned patients.</p>
            <form asp-action="Patients" asp-controller="Doctor" method="get" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
                <input type="hidden" name="userId" value="@Model.Doctor.Id" />
                <input name="fullName" value="@Model.SearchFullName" placeholder="Search by full name (exact)" style="height:38px;border:1px solid var(--line);border-radius:10px;padding:0 10px;min-width:260px;" />
                <button class="btn btn-primary" type="submit">Search</button>
                <a class="btn" href="/Doctor/Patients?userId=@Model.Doctor.Id">Reset</a>
            </form>
            @if (Model.IsSearchMode)
            {
                <p class="muted" style="margin-top:8px;font-size:13px;">Search mode active: "@Model.SearchFullName"</p>
            }

            <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr));margin-top:16px;">
                @if (Model.Patients.Count == 0)
                {
                    <div class="card" style="padding:16px;">
                        <p class="muted">No assigned patients.</p>
                    </div>
                }
                else
                {
                    @foreach (var patient in Model.Patients)
                    {
                        <a class="card" href="/Doctor/PatientDetail?userId=@Model.Doctor.Id&patientId=@patient.PatientId" style="padding:16px;">
                            <h3>@patient.FullName</h3>
                            <div class="muted" style="font-size:13px;margin-top:3px;">Patient ID: @patient.PatientId | @patient.Age y, @patient.Gender</div>
                            <div style="margin-top:10px;"><span class="badge status-completed">@patient.RecordCount records</span></div>
                            <p class="muted" style="font-size:13px;margin-top:10px;">
                                Last visit:
                                @(string.IsNullOrWhiteSpace(patient.LastDiagnosis) ? "-" : patient.LastDiagnosis)
                                @if (patient.LastVisitDate is not null)
                                {
                                    <span>(@patient.LastVisitDate.Value.ToLocalTime().ToString("dd MMM yyyy"))</span>
                                }
                            </p>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const sidebar = document.getElementById("sidebar");
    const menuBtn = document.querySelector("[data-open-menu]");
    if (menuBtn) menuBtn.addEventListener("click", () => sidebar.classList.toggle("open"));
</script>
}

