@using HospitalPatientManager.ViewModels
@model AdminDoctorsViewModel
@{
    ViewData["Title"] = "Admin Doctors";
}

<div class="shell app-shell">
    <aside class="sidebar" id="sidebar">
        <div class="brand" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
            <strong>MediCare</strong>
            <button
                type="button"
                id="closeSidebarBtn"
                class="menu-btn"
                aria-label="Close sidebar"
                style="border-color:#26414b;background:transparent;color:#dce8ec;">
                x
            </button>
        </div>
        <nav class="nav">
            <a href="/Admin/Dashboard">Dashboard</a>
            <a href="/Admin/Patients">List Patient</a>
            <a class="active" href="/Admin/Doctors">List Doctor</a>
            <a href="/Admin/Records">List Checkup Records</a>
        </nav>
        <div class="sidebar-user">
            <div class="avatar">AD</div>
            <div><div style="font-size:14px;font-weight:600;">Admin</div><div style="font-size:12px;color:#8eabb5;">System</div></div>
            <a href="/Account/Logout" class="btn btn-primary" style="margin-left:auto;padding:6px 10px;">Out</a>
        </div>
    </aside>
    <div id="sidebarBackdrop" style="position:fixed;inset:0;background:rgba(0,0,0,.35);display:none;z-index:15;"></div>

    <div class="content">
        <header class="mobile-top">
            <button class="menu-btn" data-open-menu>&#9776;</button>
            <strong>MediCare</strong>
            <div class="avatar" style="width:30px;height:30px;font-size:12px;">AD</div>
        </header>
        <div class="page">
            <h1 style="font-size:28px;">List Doctor</h1>
            <p class="muted" style="margin-top:6px;">All doctors in database.</p>
            <form asp-action="Doctors" asp-controller="Admin" method="get" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
                <input name="searchTerm" value="@Model.SearchTerm" placeholder="Search doctor by name/specialization" style="height:38px;border:1px solid var(--line);border-radius:10px;padding:0 10px;min-width:300px;" />
                <button class="btn btn-primary" type="submit">Search</button>
                <a class="btn" href="/Admin/Doctors">Reset</a>
            </form>

            <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr));margin-top:16px;">
                @if (Model.Doctors.Count == 0)
                {
                    <div class="card" style="padding:16px;"><p class="muted">No doctor data.</p></div>
                }
                else
                {
                    @foreach (var doctor in Model.Doctors)
                    {
                        <div class="card" style="padding:16px;">
                            <h3>@doctor.FullName</h3>
                            <div class="muted" style="font-size:13px;margin-top:3px;">Doctor ID: @doctor.DoctorId</div>
                            <p style="margin-top:10px;"><strong>@doctor.Specialization</strong></p>
                            <div style="margin-top:10px;"><span class="badge status-completed">@doctor.RecordCount records</span></div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<button
    type="button"
    id="openAddDoctorModal"
    class="btn btn-primary"
    style="position:fixed;right:24px;bottom:24px;z-index:55;border-radius:999px;padding:12px 16px;box-shadow:0 10px 24px rgba(0,0,0,.18);">
    + Add Doctor
</button>

<div id="addDoctorModal" style="position:fixed;inset:0;background:rgba(0,0,0,.4);display:none;align-items:center;justify-content:center;padding:16px;z-index:60;">
    <div class="card" style="width:min(640px,100%);padding:20px;max-height:90vh;overflow:auto;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
            <h3 style="margin:0;font-size:20px;">Tambah Doctor</h3>
            <button type="button" class="btn" id="closeAddDoctorModal">Close</button>
        </div>

        <form asp-action="AddDoctor" asp-controller="Admin" method="post" class="grid" style="grid-template-columns:1fr;margin-top:12px;">
            @Html.AntiForgeryToken()

            <label style="font-size:13px;">Full Name:
                <input name="FullName" placeholder="Doctor Full Name (e.g., Nanda Lestari)" required style="height:38px;border:1px solid var(--line);border-radius:10px;padding:0 10px;display:block;width:100%;margin-top:6px;" />
            </label>

            <label style="font-size:13px;">Specialization:
                <input name="Specialization" placeholder="Specialization" required style="height:38px;border:1px solid var(--line);border-radius:10px;padding:0 10px;display:block;width:100%;margin-top:6px;" />
            </label>

            <button class="btn btn-primary" type="submit">Add Doctor</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const sidebar = document.getElementById("sidebar");
    const menuBtn = document.querySelector("[data-open-menu]");
    const closeSidebarBtn = document.getElementById("closeSidebarBtn");
    const sidebarBackdrop = document.getElementById("sidebarBackdrop");

    const closeSidebar = () => {
        if (!sidebar) return;
        sidebar.classList.remove("open");
        if (sidebarBackdrop) sidebarBackdrop.style.display = "none";
    };

    if (menuBtn) {
        menuBtn.addEventListener("click", () => {
            if (!sidebar) return;
            const willOpen = !sidebar.classList.contains("open");
            sidebar.classList.toggle("open");
            if (sidebarBackdrop) sidebarBackdrop.style.display = willOpen ? "block" : "none";
        });
    }

    if (sidebarBackdrop) {
        sidebarBackdrop.addEventListener("click", closeSidebar);
    }

    if (closeSidebarBtn) {
        closeSidebarBtn.addEventListener("click", closeSidebar);
    }

    document.querySelectorAll(".sidebar .nav a").forEach(link => {
        link.addEventListener("click", closeSidebar);
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeSidebar();
        }
    });
const addDoctorModal = document.getElementById("addDoctorModal");
    const openAddDoctorModalBtn = document.getElementById("openAddDoctorModal");
    const closeAddDoctorModalBtn = document.getElementById("closeAddDoctorModal");

    const closeAddDoctorModal = () => {
        addDoctorModal.style.display = "none";
    };

    if (openAddDoctorModalBtn) {
        openAddDoctorModalBtn.addEventListener("click", () => {
            addDoctorModal.style.display = "flex";
        });
    }

    if (closeAddDoctorModalBtn) {
        closeAddDoctorModalBtn.addEventListener("click", closeAddDoctorModal);
    }

    if (addDoctorModal) {
        addDoctorModal.addEventListener("click", (event) => {
            if (event.target === addDoctorModal) {
                closeAddDoctorModal();
            }
        });
    }
</script>
}


