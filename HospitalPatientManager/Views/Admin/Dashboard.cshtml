@using HospitalPatientManager.ViewModels
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="shell">
    <aside class="sidebar" id="sidebar">
        <div class="brand"><strong>MediCare</strong></div>
        <nav class="nav">
            <a class="active" href="/Admin/Dashboard">Dashboard</a>
            <a href="/Admin/Patients">List Patient</a>
            <a href="/Admin/Doctors">List Doctor</a>
            <a href="/Admin/Records">List Checkup Records</a>
        </nav>
        <div class="sidebar-user">
            <div class="avatar">AD</div>
            <div><div style="font-size:14px;font-weight:600;">Admin</div><div style="font-size:12px;color:#8eabb5;">System</div></div>
            <a href="/Account/Logout" class="btn btn-primary" style="margin-left:auto;padding:6px 10px;">Out</a>
        </div>
    </aside>

    <div class="content">
        <header class="mobile-top">
            <button class="menu-btn" data-open-menu>Menu</button>
            <strong>MediCare</strong>
            <div class="avatar" style="width:30px;height:30px;font-size:12px;">AD</div>
        </header>
        <div class="page">
            <h1 style="font-size:28px;">Admin Dashboard</h1>
            <p class="muted" style="margin-top:6px;">Overview of all data in database.</p>

            <div class="grid" style="grid-template-columns:repeat(3,minmax(0,1fr));margin-top:16px;">
                <div class="card stats-item"><div class="stats-icon">R</div><div><h3>@Model.TotalCheckups</h3><div class="muted" style="font-size:12px;">Total Checkups</div></div></div>
                <div class="card stats-item"><div class="stats-icon">P</div><div><h3>@Model.TotalPatients</h3><div class="muted" style="font-size:12px;">Total Patients</div></div></div>
                <div class="card stats-item"><div class="stats-icon">D</div><div><h3>@Model.TotalDoctors</h3><div class="muted" style="font-size:12px;">Total Doctors</div></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const sidebar = document.getElementById("sidebar");
    const menuBtn = document.querySelector("[data-open-menu]");
    if (menuBtn) menuBtn.addEventListener("click", () => sidebar.classList.toggle("open"));
</script>
}

