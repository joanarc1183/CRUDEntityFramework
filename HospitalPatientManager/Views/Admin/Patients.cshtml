@using HospitalPatientManager.ViewModels
@model AdminPatientsViewModel
@{
    ViewData["Title"] = "Admin Patients";
}

<div class="shell">
    <aside class="sidebar" id="sidebar">
        <div class="brand"><strong>MediCare</strong></div>
        <nav class="nav">
            <a href="/Admin/Dashboard">Dashboard</a>
            <a class="active" href="/Admin/Patients">List Patient</a>
            <a href="/Admin/Doctors">List Doctor</a>
            <a href="/Admin/Records">List Checkup Records</a>
        </nav>
        <div class="sidebar-user">
            <div class="avatar">AD</div>
            <div><div style="font-size:14px;font-weight:600;">Admin</div><div style="font-size:12px;color:#8eabb5;">System</div></div>
            <a href="/Account/Logout" class="btn btn-primary" style="margin-left:auto;padding:6px 10px;">Out</a>
        </div>
    </aside>

    <div class="content">
        <header class="mobile-top">
            <button class="menu-btn" data-open-menu>Menu</button>
            <strong>MediCare</strong>
            <div class="avatar" style="width:30px;height:30px;font-size:12px;">AD</div>
        </header>
        <div class="page">
            <h1 style="font-size:28px;">List Patient</h1>
            <p class="muted" style="margin-top:6px;">All patients in database.</p>
            <form asp-action="Patients" asp-controller="Admin" method="get" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
                <input name="searchTerm" value="@Model.SearchTerm" placeholder="Search patient by name" style="height:38px;border:1px solid var(--line);border-radius:10px;padding:0 10px;min-width:260px;" />
                <button class="btn btn-primary" type="submit">Search</button>
                <a class="btn" href="/Admin/Patients">Reset</a>
            </form>

            <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr));margin-top:16px;">
                @if (Model.Patients.Count == 0)
                {
                    <div class="card" style="padding:16px;"><p class="muted">No patient data.</p></div>
                }
                else
                {
                    @foreach (var patient in Model.Patients)
                    {
                        <a class="card" href="/Admin/PatientDetail?patientId=@patient.PatientId" style="padding:16px;">
                            <h3>@patient.FullName</h3>
                            <div class="muted" style="font-size:13px;margin-top:3px;">@patient.Age y, @patient.Gender</div>
                            <div style="margin-top:10px;"><span class="badge status-completed">@patient.RecordCount records</span></div>
                            <p class="muted" style="font-size:13px;margin-top:10px;">
                                Last visit:
                                @(string.IsNullOrWhiteSpace(patient.LastDiagnosis) ? "-" : patient.LastDiagnosis)
                            </p>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const sidebar = document.getElementById("sidebar");
    const menuBtn = document.querySelector("[data-open-menu]");
    if (menuBtn) menuBtn.addEventListener("click", () => sidebar.classList.toggle("open"));
</script>
}

