<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCare</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f2f7f8;
            --fg: #12252a;
            --card: #ffffff;
            --muted: #6d7f86;
            --line: #d7e1e4;
            --primary: #139095;
            --primary-soft: #e4f4f4;
            --accent: #f4b321;
            --ok: #198b5f;
            --warn: #f4b321;
            --info: #2b78b7;
            --sidebar: #14252b;
            --sidebar-text: #dce8ec;
            --sidebar-soft: #1f353d;
            --radius: 14px;
            --shadow: 0 6px 18px rgba(8, 30, 36, 0.08);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            background: var(--bg);
            color: var(--fg);
            font-family: "Inter", sans-serif;
        }

        h1, h2, h3, h4 {
            font-family: "DM Sans", sans-serif;
            margin: 0;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            max-width: 1120px;
            margin: 0 auto;
            padding: 24px;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .muted {
            color: var(--muted);
        }

        .btn {
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 10px;
            padding: 10px 14px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            border: 1px solid var(--line);
            background: #fff;
        }

        .badge {
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 10px;
            display: inline-block;
            align-content: center;
        }

        .status-completed {
            background: #e6f5ee;
            color: var(--ok);
        }

        .status-pending {
            background: #fff4d8;
            color: #a46a00;
        }

        .status-scheduled {
            background: #e7f2fb;
            color: var(--info);
        }

        .grid {
            display: grid;
            gap: 16px;
        }

        .stats-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .stats-item {
            padding: 16px;
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .stats-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--primary-soft);
            color: var(--primary);
            font-weight: 700;
            display: grid;
            place-items: center;
        }

        .shell {
            min-height: 100vh;
            display: flex;
        }

        .sidebar {
            width: 260px;
            background: var(--sidebar);
            color: var(--sidebar-text);
            border-right: 1px solid #26414b;
            padding: 18px 12px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 10px 16px;
            border-bottom: 1px solid #26414b;
        }

        .heart {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--primary);
            color: white;
            font-weight: 700;
            display: grid;
            place-items: center;
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-top: 8px;
        }

        .nav a {
            border-radius: 10px;
            padding: 10px 12px;
            color: #abc0c8;
            font-weight: 500;
        }

        .nav a.active,
        .nav a:hover {
            background: var(--sidebar-soft);
            color: #fff;
        }

        .sidebar-user {
            margin-top: auto;
            padding: 12px;
            border-top: 1px solid #26414b;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 999px;
            background: var(--primary);
            color: #fff;
            font-weight: 700;
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }

        .content {
            flex: 1;
            min-width: 0;
        }

        .page {
            padding: 24px 30px;
        }

        .record {
            border-top: 1px solid var(--line);
        }

        .record-head {
            width: 100%;
            border: 0;
            background: transparent;
            text-align: left;
            padding: 16px 20px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

        .record-sub {
            font-size: 12px;
            color: var(--muted);
            margin-top: 4px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .record-body {
            display: none;
            padding: 0 20px 16px;
            font-size: 14px;
            color: #23383f;
        }

        .record.open .record-body {
            display: block;
        }

        .mobile-top {
            display: none;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--line);
            padding: 12px 16px;
            background: #fff;
        }

        /* Global drawer sidebar behavior for role pages (Admin/Doctor/Patient). */
        .app-shell .mobile-top {
            display: flex;
        }

        .app-shell .sidebar {
            position: fixed;
            z-index: 20;
            left: -280px;
            top: 0;
            bottom: 0;
            transition: left .2s ease;
        }

        .app-shell .sidebar.open {
            left: 0;
        }

        .app-shell .content {
            width: 100%;
        }

        .menu-btn {
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 8px;
            width: 36px;
            height: 36px;
            font-size: 18px;
        }

        @@media (max-width: 960px) {
            .stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .sidebar {
                position: fixed;
                z-index: 20;
                left: -280px;
                top: 0;
                bottom: 0;
                transition: left .2s ease;
            }

            .sidebar.open {
                left: 0;
            }

            .mobile-top {
                display: flex;
            }

            .page {
                padding: 16px;
            }
        }

        @@media (max-width: 640px) {
            .container {
                padding: 16px;
            }
        }
    </style>
</head>
<body>
    @{
        var flashSuccess = TempData["FlashSuccess"] as string;
        var flashError = TempData["FlashError"] as string;
    }
    @if (!string.IsNullOrWhiteSpace(flashSuccess))
    {
        <div style="position:fixed;top:14px;right:14px;z-index:1000;background:#e6f5ee;border:1px solid #b7e6cf;color:#0f6b47;padding:10px 14px;border-radius:10px;box-shadow:var(--shadow);max-width:380px;">
            @flashSuccess
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(flashError))
    {
        <div style="position:fixed;top:14px;right:14px;z-index:1000;background:#fff2f2;border:1px solid #f2c3c3;color:#9e2f2f;padding:10px 14px;border-radius:10px;box-shadow:var(--shadow);max-width:380px;">
            @flashError
        </div>
    }
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
